<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist. Hymn accompaniment keeps playing with the screen locked. -->
	<!-- Advent Praise's Features.Vote board slug, from the FEATURES_VOTE_API_KEY build setting (empty in the repo). Empty hides More → Vote on features. See FVOTE_STATUS.md. -->
	<key>FEATURES_VOTE_API_KEY</key>
	<string>$(FEATURES_VOTE_API_KEY)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- The mark on the brand ground (evergreen; Stage in dark). SplashView starts from exactly this frame. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
</dict>
</plist>
