<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup (Android 11 and below). The free-play count rides along so a reinstall
     doesn't hand out five more plays (iOS keeps it in the Keychain); with it the reading
     settings, the reader's hymnal, favourites and playlists, and the analytics switch. -->
<full-backup-content>
    <include domain="sharedpref" path="freePlays.v2.xml" />
    <include domain="sharedpref" path="freePlays.v2.debug.xml" />
    <include domain="sharedpref" path="settings.xml" />
    <include domain="sharedpref" path="reader.xml" />
    <include domain="sharedpref" path="analytics.xml" />
</full-backup-content>
