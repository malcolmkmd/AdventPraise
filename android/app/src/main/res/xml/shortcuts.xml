<?xml version="1.0" encoding="utf-8"?>
<!--
    The app's shortcuts on a long-press of its icon: Android's side of iOS's App
    Shortcuts (Intents/HymnIntents.swift: Open Hymn, Start Church Mode) plus Hymn
    of the Day. Each opens an adventpraise://shortcut/… link in MainActivity,
    handled by shortcuts/AppShortcuts.kt. Registered by the launcher activity's
    <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />.
-->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="open_hymn"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_open_hymn"
        android:shortcutShortLabel="@string/shortcut_open_hymn_short"
        android:shortcutLongLabel="@string/shortcut_open_hymn_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="adventpraise://shortcut/open-hymn"
            android:targetPackage="com.mDev.AdventPraise"
            android:targetClass="com.mDev.AdventPraise.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="hymn_of_the_day"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_hymn_of_the_day"
        android:shortcutShortLabel="@string/shortcut_hymn_of_the_day_short"
        android:shortcutLongLabel="@string/shortcut_hymn_of_the_day_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="adventpraise://shortcut/hymn-of-the-day"
            android:targetPackage="com.mDev.AdventPraise"
            android:targetClass="com.mDev.AdventPraise.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="church_mode"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_church_mode"
        android:shortcutShortLabel="@string/shortcut_church_mode_short"
        android:shortcutLongLabel="@string/shortcut_church_mode_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="adventpraise://shortcut/church-mode"
            android:targetPackage="com.mDev.AdventPraise"
            android:targetClass="com.mDev.AdventPraise.MainActivity" />
    </shortcut>
</shortcuts>
